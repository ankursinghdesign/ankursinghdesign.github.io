---
import "../styles/global.css";

interface Props { title: string; description?: string; }
const { title, description = "Ankur Singh, senior UX and product designer." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Caveat:wght@500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href="/">Ankur Singh <span>/ Senior UX Designer</span></a>
      <nav class="tools" aria-label="Main">
        <a class="nav hide-sm" href="/#work">Work</a>
        <a class="nav hide-sm" href="/#about">About</a>
        <a class="nav hide-sm" href="#contact">Contact</a>
        <button class="chip" id="lockBtn" aria-pressed="false" aria-haspopup="dialog"><span aria-hidden="true">🔒</span> <span class="lbl">Private view</span></button>
      </nav>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="foot" id="contact">
    <div class="wrap">
      <p class="mono">Contact</p>
      <p class="big"><a href="mailto:ankursingh.design@gmail.com">ankursingh.design@gmail.com</a></p>
      <p class="muted small"><a href="https://www.linkedin.com/in/ankurandsingh">LinkedIn</a> · Based in India · Open to remote, UK and EU roles</p>
    </div>
  </footer>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <dialog id="unlockDlg" aria-labelledby="unlockTitle">
    <form method="dialog" id="unlockForm">
      <p class="mono">Private view</p>
      <h2 id="unlockTitle">Unlock the full case studies</h2>
      <p class="muted">Client screens and names are under NDA. They're encrypted here and shared with interviewers on request.</p>
      <label class="mono" for="pass">Passphrase</label>
      <input id="pass" type="password" autocomplete="current-password" required />
      <p class="err" id="unlockErr" role="alert"></p>
      <div class="row"><button type="button" class="btn ghost" id="unlockCancel">Cancel</button><button class="btn" id="unlockGo">Unlock</button></div>
    </form>
  </dialog>

  <script>
    import "../scripts/site.ts";
  </script>
</body>
</html>

<style is:global>
  header.top { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 84%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; justify-content: space-between; align-items: center; height: 60px; gap: 12px; }
  .brand { font-weight: 600; letter-spacing: -.01em; text-decoration: none; white-space: nowrap; }
  .brand span { color: var(--ink-2); font-weight: 400; }
  .tools { display: flex; gap: 8px; align-items: center; }
  .nav { font-size: 15px; text-decoration: none; padding: 6px 10px; border-radius: 6px; transition: color var(--t-micro); }
  .nav:hover { color: var(--accent); }
  .tools .chip { margin-left: 14px; }
  html.private #lockBtn { background: var(--ok); border-color: var(--ok); color: #fff; }

  .foot { border-top: 1px solid var(--line); padding: 96px 0 72px; margin-top: 96px; }
  .foot .big { font-size: clamp(28px, 4vw, 48px); letter-spacing: -.03em; margin: 8px 0 12px; }
  .foot .big a { text-decoration: none; background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100% / 0 2px; transition: background-size .5s var(--ease); }
  .foot .big a:hover { background-size: 100% 2px; }
  .small { font-size: 14px; }

  .toast { position: fixed; left: 50%; bottom: 28px; transform: translate(-50%, 16px); opacity: 0; background: var(--ink); color: var(--bg); font: 500 13px var(--mono); padding: 10px 14px; border-radius: 8px; transition: all .35s var(--ease); z-index: 90; pointer-events: none; }
  .toast.on { opacity: 1; transform: translate(-50%, 0); }

  dialog { border: 1px solid var(--line); border-radius: 14px; padding: 28px; max-width: 420px; width: calc(100% - 32px); background: var(--surface); color: var(--ink); }
  dialog::backdrop { background: rgba(15, 16, 18, .4); backdrop-filter: blur(6px); }
  dialog h2 { font-size: 26px; margin: 6px 0 8px; }
  dialog p.muted { font-size: 15px; margin-bottom: 16px; }
  dialog input { width: 100%; font: 16px var(--mono); padding: 12px; border: 1px solid var(--line-strong); border-radius: 8px; margin-top: 6px; background: var(--bg); color: var(--ink); }
  dialog .err { color: #C42B2B; font-size: 14px; min-height: 22px; margin-top: 6px; }
  dialog .row { display: flex; gap: 8px; justify-content: flex-end; }
  dialog.shake { animation: shake .35s; }
  @keyframes shake { 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
  @media (max-width: 820px) { .hide-sm { display: none !important; } .brand span { display: none; } }
</style>
