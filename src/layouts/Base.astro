---
import "../styles/global.css";

interface Props { title: string; description?: string; }
const { title, description = "Ankur Singh, senior UX and product designer." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    // GitHub Pages can serve the custom domain over plain http, where the Private view can't decrypt
    // (browsers only allow crypto.subtle on https). Send every http visit to https.
    if (location.protocol === "http:" && !/^(localhost|127\.0\.0\.1)$/.test(location.hostname)) location.replace("https:" + location.href.slice(5));
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script is:inline>
    // Apply the saved theme before first paint so there's no flash
    try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Caveat:wght@500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href="/">Ankur Singh <span>/ Senior Product Designer</span></a>
      <nav class="tools" aria-label="Main">
        <a class="nav hide-sm" href="/#work">Work</a>
        <a class="nav hide-sm" href="/#about">About</a>
        <a class="nav hide-sm" href="#contact">Contact</a>
        <button class="theme" id="themeBtn" type="button" aria-label="Switch to dark theme"><span class="sun" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span><span class="moon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg></span></button>
        <button class="lock" id="lockBtn" type="button" aria-pressed="false" aria-haspopup="dialog" aria-describedby="lockTip">
          <svg class="pad" viewBox="0 0 20 20" aria-hidden="true"><path class="shackle" d="M6.5 9V6.6a3.5 3.5 0 0 1 7 0V9" /><rect class="body" x="4" y="9" width="12" height="9" rx="2.4" /><circle class="hole" cx="10" cy="13.4" r="1.25" /></svg>
          <span class="lbl">Private view</span>
          <span class="tip" id="lockTip" role="tooltip"><span class="t-off">Full case studies · for interviewers</span><span class="t-on">Click to lock again</span></span>
        </button>
      </nav>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="foot" id="contact">
    <div class="wrap">
      <p class="mono">Contact</p>
      <h2 class="ask">Working on a hard workflow problem? I'd like to hear about it.</h2>
      <p class="big"><a href="mailto:ankursingh.design@gmail.com">ankursingh.design@gmail.com</a></p>
      <p class="muted small"><a href="https://www.linkedin.com/in/ankurandsingh">LinkedIn</a></p>
    </div>
  </footer>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <dialog id="unlockDlg" aria-labelledby="unlockTitle">
    <form method="dialog" id="unlockForm">
      <p class="mono">Private view</p>
      <h2 id="unlockTitle">Unlock the full case studies</h2>
      <p class="muted">Client screens and names are under NDA. They're encrypted here and shared with interviewers on request.</p>
      <label class="mono" for="pass">Passphrase</label>
      <input id="pass" type="password" autocomplete="current-password" required />
      <p class="err" id="unlockErr" role="alert"></p>
      <div class="row"><button type="button" class="btn ghost" id="unlockCancel">Cancel</button><button class="btn" id="unlockGo">Unlock</button></div>
    </form>
  </dialog>

  <script>
    import "../scripts/site.ts";
  </script>
</body>
</html>

<style is:global>
  header.top { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 84%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; justify-content: space-between; align-items: center; height: 60px; gap: 12px; }
  .brand { font-weight: 600; letter-spacing: -.01em; text-decoration: none; white-space: nowrap; }
  .brand span { color: var(--ink-2); font-weight: 400; }
  .tools { display: flex; gap: 8px; align-items: center; }
  .nav { font-size: 15px; text-decoration: none; padding: 6px 10px; border-radius: 6px; transition: color var(--t-micro); }
  .nav:hover { color: var(--accent); }
  /* Private view: a drawn padlock that lifts on hover and swings open when unlocked */
  .lock { position: relative; margin-left: 6px; display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 14px 0 11px; border-radius: 999px;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: 500 14px var(--font); cursor: pointer;
    transition: border-color var(--t-micro), background .3s, color .3s, transform .15s var(--ease); }
  .lock:hover { border-color: var(--ink); }
  .lock:active { transform: scale(.96); }
  .pad { width: 18px; height: 18px; overflow: visible; }
  .pad .shackle { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; transform-box: view-box; transform-origin: 13.5px 9px; transition: transform .45s var(--ease); }
  .pad .body { fill: currentColor; }
  .pad .hole { fill: var(--surface); transition: fill .3s; }
  .lock:hover .shackle, .lock:focus-visible .shackle { transform: translateY(-1.6px); }
  html.private .lock { background: color-mix(in srgb, var(--ok) 12%, var(--surface)); border-color: var(--ok); color: var(--ok); }
  html.private .lock .shackle { transform: translateY(-2.5px) rotate(-32deg); }
  html.private .lock .hole { fill: color-mix(in srgb, var(--ok) 12%, var(--surface)); }
  html.private.is-dark .lock { --ok: #4ADE80; }
  .lock.pop .pad { animation: pop .5s var(--ease); }
  @keyframes pop { 40% { transform: scale(1.25); } }
  .tip { position: absolute; top: calc(100% + 10px); right: 0; white-space: nowrap; font: 500 12px var(--font); color: var(--bg); background: var(--ink);
    padding: 6px 10px; border-radius: 8px; opacity: 0; translate: 0 -4px; pointer-events: none; transition: opacity .2s, translate .25s var(--ease); }
  .tip::before { content: ""; position: absolute; bottom: 100%; right: 22px; border: 5px solid transparent; border-bottom-color: var(--ink); }
  .lock:hover .tip, .lock:focus-visible .tip { opacity: 1; translate: 0 0; transition-delay: .25s; }
  .tip .t-on, html.private .tip .t-off { display: none; }
  html.private .tip .t-on { display: inline; }
  @media (hover: none) { .tip { display: none; } }
  .theme { margin-left: 8px; width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--ink); cursor: pointer; font-size: 15px; transition: border-color var(--t-micro); }
  .theme:hover { border-color: var(--ink); }
  .theme .moon, html.is-dark .theme .sun { display: none; }
  html.is-dark .theme .moon { display: inline; }
  .theme span { display: grid; place-items: center; }
  html.is-dark .theme .moon { display: grid; }

  .foot { border-top: 1px solid var(--line); padding: 96px 0 72px; margin-top: 96px; }
  .foot .ask { font-size: clamp(34px, 4.4vw, 60px); line-height: 1.02; letter-spacing: -.04em; max-width: 18ch; margin: 10px 0 28px; }
  .foot .big { font-size: clamp(28px, 4vw, 48px); letter-spacing: -.03em; margin: 8px 0 12px; }
  .foot .big a { text-decoration: none; background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100% / 0 2px; transition: background-size .5s var(--ease); }
  .foot .big a:hover { background-size: 100% 2px; }
  .small { font-size: 14px; }

  .toast { position: fixed; left: 50%; bottom: 28px; transform: translate(-50%, 16px); opacity: 0; background: var(--ink); color: var(--bg); font: 500 13px var(--mono); padding: 10px 14px; border-radius: 8px; transition: all .35s var(--ease); z-index: 90; pointer-events: none; }
  .toast.on { opacity: 1; transform: translate(-50%, 0); }

  dialog { border: 1px solid var(--line); border-radius: 14px; padding: 28px; max-width: 420px; width: calc(100% - 32px); background: var(--surface); color: var(--ink); }
  dialog::backdrop { background: rgba(15, 16, 18, .4); backdrop-filter: blur(6px); }
  dialog h2 { font-size: 26px; margin: 6px 0 8px; }
  dialog p.muted { font-size: 15px; margin-bottom: 16px; }
  dialog input { width: 100%; font: 16px var(--mono); padding: 12px; border: 1px solid var(--line-strong); border-radius: 8px; margin-top: 6px; background: var(--bg); color: var(--ink); }
  dialog .err { color: #C42B2B; font-size: 14px; min-height: 22px; margin-top: 6px; }
  dialog .row { display: flex; gap: 8px; justify-content: flex-end; }
  dialog.shake { animation: shake .35s; }
  @keyframes shake { 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
  @media (max-width: 820px) { .hide-sm { display: none !important; } .brand span { display: none; } }
</style>
