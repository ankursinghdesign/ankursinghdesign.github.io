---
// Simple drawn graphics for the "How I work" steps. Theme colours only, so they work in light and dark.
interface Props { kind: "research" | "flow" | "system" | "states"; }
const { kind } = Astro.props;
---
<div class="art" aria-hidden="true">
  {kind === "research" && (
    <svg viewBox="0 0 240 180">
      <!-- Interviewer and participant, a conversation, and notes taken -->
      <circle class="fill" cx="58" cy="104" r="15" /><path class="fill" d="M30 150c0-17 12.5-27 28-27s28 10 28 27z" />
      <circle class="acc" cx="150" cy="104" r="15" /><path class="acc" d="M122 150c0-17 12.5-27 28-27s28 10 28 27z" />
      <rect class="card" x="22" y="30" width="78" height="44" rx="10" /><path class="card" d="M48 74l-6 12 16-12z" />
      <path class="ln" d="M34 46h54M34 58h38" />
      <rect class="acc-soft" x="112" y="22" width="86" height="50" rx="10" /><path class="acc-soft" d="M150 72l4 12 10-12z" />
      <path class="ln acc-ln" d="M124 38h62M124 50h48M124 61h30" />
      <g transform="rotate(6 205 128)"><rect class="note" x="186" y="104" width="40" height="44" rx="2" /><path class="ln dark" d="M193 117h26M193 126h20M193 135h24" /></g>
    </svg>
  )}
  {kind === "flow" && (
    <svg viewBox="0 0 240 180">
      <!-- Roles and states: draft -> review -> approved, with a changes loop -->
      <rect class="card" x="14" y="40" width="58" height="30" rx="8" /><text x="43" y="59">Draft</text>
      <rect class="card" x="91" y="40" width="58" height="30" rx="8" /><text x="120" y="59">Review</text>
      <rect class="acc" x="168" y="40" width="58" height="30" rx="8" /><text class="on-acc" x="197" y="59">Approved</text>
      <path class="ln" d="M72 55h15M149 55h15" /><path class="arrow" d="M84 51l5 4-5 4M161 51l5 4-5 4" />
      <rect class="card dash" x="91" y="112" width="58" height="30" rx="8" /><text x="120" y="131">Changes</text>
      <path class="ln" d="M120 70v38M91 127H43V74" /><path class="arrow" d="M116 104l4 5 4-5M39 78l4-5 4 5" />
      <circle class="dot" cx="43" cy="30" r="5" /><circle class="dot acc-dot" cx="120" cy="30" r="5" /><circle class="dot" cx="197" cy="30" r="5" />
    </svg>
  )}
  {kind === "system" && (
    <svg viewBox="0 0 240 180">
      <!-- Tokens (colour, type, radius) feeding components -->
      <circle class="acc" cx="34" cy="38" r="13" /><circle class="ink" cx="66" cy="38" r="13" /><circle class="ok" cx="98" cy="38" r="13" /><circle class="warn" cx="130" cy="38" r="13" />
      <text class="aa" x="160" y="50">Aa</text>
      <path class="ln" d="M22 68h196" />
      <rect class="acc" x="22" y="84" width="76" height="28" rx="14" /><text class="on-acc" x="60" y="102">Button</text>
      <rect class="card" x="108" y="84" width="76" height="28" rx="14" /><text x="146" y="102">Button</text>
      <rect class="acc" x="194" y="88" width="28" height="18" rx="9" /><circle class="knob" cx="213" cy="97" r="6" />
      <rect class="card" x="22" y="124" width="200" height="32" rx="8" /><path class="ln" d="M34 140h70" /><rect class="acc-soft" x="168" y="132" width="44" height="16" rx="8" />
    </svg>
  )}
  {kind === "states" && (
    <svg viewBox="0 0 240 180">
      <!-- Empty, loading and error states, then the spec that goes to engineering -->
      <rect class="card" x="14" y="26" width="62" height="86" rx="8" /><circle class="ln-c" cx="45" cy="60" r="12" /><path class="ln" d="M32 86h26M36 96h18" />
      <rect class="card" x="89" y="26" width="62" height="86" rx="8" /><rect class="fill" x="99" y="40" width="42" height="8" rx="4" /><rect class="fill" x="99" y="56" width="30" height="8" rx="4" /><rect class="fill" x="99" y="72" width="38" height="8" rx="4" /><rect class="fill" x="99" y="88" width="24" height="8" rx="4" />
      <rect class="card" x="164" y="26" width="62" height="86" rx="8" /><path class="err" d="M195 46l14 24h-28z" /><path class="ln" d="M182 86h26M186 96h18" />
      <path class="ln" d="M45 124v14h150v-14M120 138v10" />
      <rect class="acc" x="84" y="148" width="72" height="22" rx="11" /><text class="on-acc" x="120" y="163">Spec ›</text>
    </svg>
  )}
</div>

<style>
  .art { aspect-ratio: 4 / 3; border-radius: var(--r-md); border: 1px solid var(--line); background: var(--surface); display: grid; place-items: center; overflow: hidden; }
  svg { width: 86%; height: auto; }
  text { font: 600 10px var(--font); fill: var(--ink-2); text-anchor: middle; }
  .aa { font: 600 34px var(--font); fill: var(--ink); text-anchor: start; letter-spacing: -.03em; }
  .on-acc { fill: var(--accent-ink); }
  .fill { fill: var(--surface-2); }
  .card { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.5; }
  .dash { stroke-dasharray: 4 3; }
  .acc { fill: var(--accent); }
  .acc-soft { fill: color-mix(in srgb, var(--accent) 14%, var(--surface)); }
  .ink { fill: var(--ink); }
  .ok { fill: #1F9D57; }
  .warn { fill: #E8A33A; }
  .err { fill: #E5484D; }
  .note { fill: #FFE58A; }
  .knob { fill: #fff; }
  .ln, .ln-c { fill: none; stroke: var(--ink-3); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .acc-ln { stroke: var(--accent); }
  .dark { stroke: #6B5B1E; }
  .arrow { fill: none; stroke: var(--ink-3); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .dot { fill: var(--line-strong); }
  .acc-dot { fill: var(--accent); }
</style>
