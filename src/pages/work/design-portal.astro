<script>
  // Voice states: Phone / Desktop switch
  document.querySelectorAll<HTMLElement>(".vdev").forEach(box => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>("[data-vd]")];
    const select = (btn: HTMLButtonElement) => {
      tabs.forEach(t => { const on = t === btn; t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1; });
      box.querySelectorAll<HTMLElement>(".vd").forEach(p => { p.hidden = p.id !== btn.getAttribute("aria-controls"); });
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", e => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; n.focus(); select(n); }
      });
    });
  });
  // Voice flow stepper
  document.querySelectorAll<HTMLElement>(".vflow").forEach(box => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>("[data-vf]")];
    const select = (btn: HTMLButtonElement) => {
      tabs.forEach(t => t.setAttribute("aria-selected", String(t === btn)));
      box.querySelectorAll<HTMLElement>(".vf").forEach(v => v.classList.toggle("on", v.dataset.for === btn.dataset.vf));
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", e => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; n.focus(); select(n); }
      });
    });
  });
  // Before/after flow toggle
  document.querySelectorAll<HTMLElement>(".flow").forEach(fig => {
    fig.querySelectorAll<HTMLButtonElement>("[data-set]").forEach(btn => btn.addEventListener("click", () => {
      fig.dataset.state = btn.dataset.set!;
      fig.querySelectorAll("[data-set]").forEach(b => b.setAttribute("aria-pressed", String(b === btn)));
    }));
  });
  // Table / Kanban / Timeline switcher
  document.querySelectorAll<HTMLElement>(".views").forEach(box => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>("[data-v]")];
    const select = (btn: HTMLButtonElement) => {
      tabs.forEach(t => t.setAttribute("aria-selected", String(t === btn)));
      box.querySelectorAll<HTMLElement>(".v").forEach(v => v.classList.toggle("on", v.dataset.for === btn.dataset.v));
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", e => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; n.focus(); select(n); }
      });
    });
  });
</script>

