---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import StepArt from "../components/StepArt.astro";
import WorkThumb from "../components/WorkThumb.astro";

const experience = [
  // Titles and dates match LinkedIn exactly; recruiters compare the two
  { dates: "2014 — Present", title: "Senior User Experience Designer", titleDates: "Oct 2021 – Present", org: "Pratham Software (PSI), Jaipur",
    earlier: [{ title: "User Experience Lead", dates: "Oct 2016 – Sep 2021" }, { title: "Senior Software Engineer", dates: "Aug 2014 – Sep 2016" }],
    text: "I lead a team of three designers and design B2B products for clients in the UK and the US, from the first interview and the information architecture to the design system and every state at developer handoff.",
    projects: [
      { when: "2022 — now", what: "Design systems for software providers in fashion and packaging" },
      { when: "2019 — 20", what: "Enterprise tools for consulting and lab-management firms" },
      { when: "2017 — 18", what: "Research-led mobile apps for clients in Australia, the US and India" },
      { when: "2014 — 16", what: "Front ends I designed and built in HTML, CSS and JavaScript" },
    ],
    recognition: "Pratham awards: Quality and Delivery Excellence (2016, 2024), Emerging Employee of the Year (2015) and Customer Delight.",
    tags: ["UX research", "Interaction design", "Design systems", "Accessibility", "AI features", "HTML & CSS"] },
  { dates: "2012 — 2014", title: "Media Designer", titleDates: "Mar 2012 – Jul 2014", org: "Enhance Systems Pvt. Ltd., New Delhi", earlier: [], projects: [], recognition: "",
    text: "E-learning modules, simulations, animation and presentation design.",
    tags: ["E-learning", "Animation", "Presentations"] },
];

const work: { title: string; href: string; thumb: "portal" | "waste" | "edu" | "a11y"; what: string; outcome: string; tags: string[] }[] = [
  { title: "Design-approval portal", href: "/work/design-portal", thumb: "portal",
    what: "A design-approval portal for a UK apparel supplier, its designers and its retail buyers, replacing phone calls, WhatsApp and email. Includes a voice-to-brief feature with 37 designed failure states.",
    outcome: "Live, about 1,000 users, workflow email cut from 1,000+ a day to zero, 300%+ productivity (measured by the client)",
    tags: ["B2B SaaS", "Design system", "Voice UI", "AI features"] },
  { title: "Waste-management platform", href: "/work/waste-platform", thumb: "waste",
    what: "Customer setup, billing and operations for a US waste-management software provider. A 50+ field spreadsheet became a four-step wizard.",
    outcome: "Shipped, Customer Delight Award",
    tags: ["Enterprise SaaS", "Information architecture", "Dashboards"] },
  { title: "Accessibility audit", href: "/work/accessibility-audit", thumb: "a11y",
    what: "A WCAG 2.1 audit of a live consumer web app, with each finding rebuilt as a working lab you can try.",
    outcome: "10 of 18 checks failed, each with an owner and a fix",
    tags: ["Accessibility", "WCAG 2.1 AA", "Usability"] },
  { title: "Education-funds platform", href: "/work/edu-funds", thumb: "edu",
    what: "An education-funds platform for a state programme: oversight, administrators, providers and families on one record. Designed for a bid that didn't win, and why that still mattered.",
    outcome: "Bid design, not awarded",
    tags: ["Gov-tech", "Multi-role UX", "Workflows"] },
];

// Expertise across my career, not tied to the four case studies (they are a sample of the work)
const expertise = [
  { title: "UX research and discovery", text: "I talk to the people who do the work before designing anything, then turn what I learn into clear problems, priorities and a shared picture of the workflow.",
    tags: ["User interviews", "SME workshops", "Usability testing", "Affinity mapping"] },
  { title: "Information architecture and interaction design", text: "I untangle complex, multi-role workflows into structures people can learn: clear navigation, sensible states, and forms people actually finish.",
    tags: ["Information architecture", "User flows", "Wireframes", "Prototyping"] },
  { title: "Design systems and visual design", text: "Tokens, components and written specs, so teams ship consistent, polished UI and engineering builds what was designed.",
    tags: ["Design tokens", "Component libraries", "Figma", "Developer handoff"] },
  { title: "Accessibility", text: "Accessible by default, not as an afterthought: WCAG 2.2 AA from the first sketch, and audits for products that are already live.",
    tags: ["WCAG 2.2 AA", "Accessibility audits", "Keyboard and focus", "Colour contrast"] },
  { title: "AI-assisted product design", text: "Designing AI features people can trust and review, and using AI tools in my own work to prototype and test ideas faster.",
    tags: ["AI features", "Claude", "Lovable", "Rapid prototyping"] },
  { title: "Front-end code", text: "I build what I design: HTML, CSS and JavaScript prototypes that prove an idea works and make handoff to engineering easier.",
    tags: ["HTML", "CSS", "JavaScript"] },
  { title: "Design leadership", text: "I lead a team of three designers, help hire, train and mentor them, and work every day with product managers and engineers.",
    tags: ["Mentoring", "Hiring", "Design reviews", "Cross-functional teams"] },
];

const steps: { art: "research" | "flow" | "system" | "states"; title: string; text: string }[] = [
  { art: "research", title: "Learn from the people doing the work", text: "Interviews and SME sessions, captured in a field-mapping sheet: every field, rule and exception." },
  { art: "flow", title: "Map the workflow and the states", text: "Roles, statuses and hand-offs first, so every screen has a reason to exist." },
  { art: "system", title: "Build the system", text: "Colour, type and semantic tokens, then components with their rules written down." },
  { art: "states", title: "Design every state, then hand off", text: "Empty, loading, error, offline and permission states, with a spec for each screen." },
];
---
<Base title="Ankur Singh · Senior Product Designer">
  <div class="spot" aria-hidden="true"></div>

  <Hero />

  <div class="wrap split">
    <aside class="left">
      <div>
        <p class="name">Ankur Singh</p>
        <p class="role">Senior Product Designer</p>
        <p class="pitch">I research, design and build products for complex workflows.</p>
        <nav class="toc" aria-label="On this page">
          <a href="#about" data-sec="about"><i></i>About</a>
          <a href="#experience" data-sec="experience"><i></i>Experience</a>
          <a href="#work" data-sec="work"><i></i>Work</a>
          <a href="#expertise" data-sec="expertise"><i></i>Expertise</a>
          <a href="#process" data-sec="process"><i></i>How I work</a>
        </nav>
      </div>
      <ul class="social">
        <li><a href="https://www.linkedin.com/in/ankurandsingh" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a></li>
        <li><a href="mailto:ankursingh.design@gmail.com" aria-label="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.2V17h16V7.2l-8 5.3-8-5.3zM5.6 7l6.4 4.2L18.4 7H5.6z"/></svg></a></li>
      </ul>
    </aside>

    <div class="right">
      <section id="about" class="sec" aria-label="About">
        <h2 class="sec-h">About</h2>
        <p>I'm Ankur, a senior product designer with <em>14+ years in design</em>, 12 of them in UX. I design B2B products for complex, multi-role workflows, the kind of software people use all day to get real work done.</p>
        <p>My work covers the whole journey: <em>user research</em> with the people doing the job, information architecture and interaction design, <em>design systems</em> and accessible interfaces, and the <em>front-end code</em> to prove it works. I lead a team of three designers and work every day with product managers and engineers, using AI tools to prototype and test ideas faster.</p>
        <p>I trained in animation and web design at Arena Animation, started in 2012 as a media designer making e-learning, animation and presentations, and moved into UX in 2014, first designing and building front ends, then leading research-led projects for clients in the UK, the US and Australia.</p>
        <p>Off the screen I'm an active person. I play cricket, badminton, table tennis and pickleball, love watching sport as much as playing it, and have recently gone back to the gym after a few years away.</p>
      </section>

      <section id="experience" class="sec" aria-label="Experience">
        <h2 class="sec-h">Experience</h2>
        <ol class="list">
          {experience.map(x => (
            <li class="item">
              <span class="when mono">{x.dates}</span>
              <div>
                <h3>{x.title} <span class="org">· {x.org}</span></h3>
                <p class="earlier">{x.titleDates}</p>
                {x.earlier.map(t => <p class="earlier">{t.title} · {t.dates}</p>)}
                <p class="txt">{x.text}</p>
                {x.projects.length > 0 && (
                  <ul class="proj" aria-label="Other projects at this company">
                    {x.projects.map(p => <li><span class="mono">{p.when}</span><span>{p.what}</span></li>)}
                  </ul>
                )}
                {x.recognition && <p class="outcome">{x.recognition}</p>}
                <ul class="chips">{x.tags.map(t => <li>{t}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
        <a class="more" href="/Ankur-Singh-Resume.pdf">View full résumé <span aria-hidden="true">↗</span></a>
      </section>

      <section id="work" class="sec" aria-label="Selected work">
        <h2 class="sec-h">Work</h2>
        <ol class="list works">
          {work.map(w => (
            <li class="item">
              <div class="thumb"><WorkThumb kind={w.thumb} /></div>
              <div>
                <h3><a class="stretch" href={w.href}>{w.title} <span class="arr" aria-hidden="true">→</span></a></h3>
                <p class="txt">{w.what}</p>
                <p class="outcome">{w.outcome}</p>
                <ul class="chips">{w.tags.map(t => <li>{t}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
        <p class="nda muted">Client screens inside the case studies are blurred for NDA. Interviewers can ask for the passphrase to the private view.</p>
      </section>

      <section id="expertise" class="sec" aria-label="Expertise">
        <h2 class="sec-h">Expertise</h2>
        <ol class="list plain">
          {expertise.map((x, i) => (
            <li class="item">
              <div>
                <h3>{x.title}</h3>
                <p class="txt">{x.text}</p>
                <ul class="chips">{x.tags.map(t => <li>{t}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="process" class="sec" aria-label="How I work">
        <h2 class="sec-h">How I work</h2>
        <p class="intro">Four steps on every project, from the first interview to developer handoff.</p>
        <ol class="list steps">
          {steps.map((st, i) => (
            <li class="item">
              <StepArt kind={st.art} />
              <div>
                <span class="when mono">Step {i + 1}</span>
                <h3>{st.title}</h3>
                <p class="txt">{st.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>
</Base>

<script>
  // Dot grid that shows only around the cursor (mouse and trackpad only)
  const spot = document.querySelector<HTMLElement>(".spot")!;
  if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
    addEventListener("pointermove", e => {
      spot.style.setProperty("--x", `${e.clientX}px`);
      spot.style.setProperty("--y", `${e.clientY}px`);
      spot.classList.add("on");
    }, { passive: true });
    document.addEventListener("pointerleave", () => spot.classList.remove("on"));
  }

  // Highlight the section in view in the left nav
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  const seen = new Map<string, boolean>();
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => seen.set(e.target.id, e.isIntersecting));
    const current = links.find(l => seen.get(l.dataset.sec!));
    if (current) links.forEach(l => l.classList.toggle("on", l === current));
  }, { rootMargin: "-30% 0px -55% 0px" });
  document.querySelectorAll(".sec").forEach(s => io.observe(s));
</script>

<style>
  .spot { position: fixed; inset: 0; z-index: -1; pointer-events: none; opacity: 0; transition: opacity .6s;
    background: radial-gradient(circle, color-mix(in srgb, var(--ink) 22%, transparent) 1px, transparent 1.4px) 0 0 / 20px 20px;
    -webkit-mask: radial-gradient(180px circle at var(--x, 50%) var(--y, 50%), #000, transparent 100%); mask: radial-gradient(180px circle at var(--x, 50%) var(--y, 50%), #000, transparent 100%); }
  .spot.on { opacity: 1; }


  .split { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 64px; }
  .left { position: sticky; top: 60px; height: calc(100svh - 60px); display: flex; flex-direction: column; justify-content: space-between; padding: 88px 0 56px; }
  .left .name { font-size: clamp(40px, 4.6vw, 56px); font-weight: 600; letter-spacing: -.035em; line-height: 1; }
  .role { font-size: 20px; font-weight: 500; margin-top: 12px; letter-spacing: -.01em; }
  .pitch { color: var(--ink-2); margin-top: 14px; max-width: 30ch; }

  .toc { display: grid; gap: 4px; margin-top: 56px; width: max-content; }
  .toc a { display: flex; align-items: center; gap: 16px; padding: 10px 0; text-decoration: none; font: 500 14px var(--font); color: var(--ink-3); transition: color var(--t-micro); }
  .toc i { display: block; width: 32px; height: 1px; background: currentColor; transition: width .3s var(--ease); }
  .toc a:hover, .toc a.on { color: var(--ink); }
  .toc a:hover i, .toc a.on i { width: 64px; }

  .social { list-style: none; padding: 0; display: flex; gap: 20px; }
  .social a { display: block; color: var(--ink-2); transition: color var(--t-micro); }
  .social a:hover { color: var(--ink); }
  .social svg { width: 22px; height: 22px; fill: currentColor; }

  .right { padding: 88px 0 24px; }
  .sec { scroll-margin-top: 90px; margin-bottom: 112px; }
  .sec-h { font: 600 15px var(--font); letter-spacing: -.01em; color: var(--ink); margin-bottom: 24px; }
  #about p { color: var(--ink-2); margin-bottom: 16px; }
  #about em { font-style: normal; color: var(--ink); font-weight: 500; }

  .list { list-style: none; padding: 0; display: grid; gap: 12px; }
  .item { position: relative; display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 24px; padding: 20px; margin: 0 -20px; border-radius: var(--r-md); border: 1px solid transparent; transition: background var(--t-micro), border-color var(--t-micro), opacity .25s; }
  @media (hover: hover) {
    .list:hover .item { opacity: .5; }
    .list .item:hover { opacity: 1; background: color-mix(in srgb, var(--surface) 70%, transparent); border-color: var(--line); }
  }
  .when { padding-top: 4px; color: var(--ink-3); font-size: 13px; }
  .item h3 { font-size: 17px; font-weight: 500; letter-spacing: -.01em; line-height: 1.35; }
  .org { color: var(--ink-2); }
  .earlier { color: var(--ink-3); font-size: 15px; line-height: 1.5; }
  .txt { color: var(--ink-2); font-size: 15px; margin-top: 8px; }
  .outcome { font-size: 14px; margin-top: 8px; }
  .proj { list-style: none; padding: 0; margin-top: 12px; display: grid; gap: 6px; }
  .proj li { display: grid; grid-template-columns: 88px 1fr; gap: 12px; color: var(--ink-2); font-size: 14px; line-height: 1.45; }
  .proj .mono { color: var(--ink-3); white-space: nowrap; }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .chips li { font: 500 12px var(--font); color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); border-radius: 999px; padding: 4px 12px; }

  .stretch { text-decoration: none; }
  .stretch::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .stretch:focus-visible { outline: none; }
  .item:has(.stretch:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .arr { display: inline-block; color: var(--accent); transition: transform .25s var(--ease); }
  .item:hover .arr { transform: translateX(4px); }
  .item:hover h3 a { color: var(--accent); }

  .works .item { grid-template-columns: 200px minmax(0, 1fr); }
  .plain .item { grid-template-columns: minmax(0, 1fr); }
  .thumb { width: 200px; margin-top: 4px; }

  .more { display: inline-flex; gap: 6px; margin-top: 28px; font-weight: 500; text-decoration: none; border-bottom: 1px solid transparent; transition: border-color var(--t-micro); }
  .more:hover { border-color: var(--accent); }
  .nda { font-size: 14px; margin-top: 24px; }

  .intro { color: var(--ink-2); margin: -8px 0 16px; }
  .steps .item { grid-template-columns: 200px minmax(0, 1fr); }
  .steps .when { display: block; padding: 0 0 4px; }

  @media (max-width: 1024px) {
    .split { grid-template-columns: 1fr; gap: 0; }
    .left { position: static; height: auto; padding: 56px 0 8px; gap: 28px; }
    .toc { display: none; }
    .right { padding-top: 48px; }
    .sec { margin-bottom: 80px; }
    .sec-h { position: sticky; top: 60px; z-index: 5; margin: 0 calc(-1 * var(--gutter)) 20px; padding: 14px var(--gutter); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); }
  }
  @media (max-width: 600px) {
    .item, .works .item, .steps .item { grid-template-columns: 1fr; gap: 10px; margin: 0; padding: 16px 0; }
    .thumb { width: 100%; }
    .steps .item { grid-template-columns: 1fr; }
  }
</style>
